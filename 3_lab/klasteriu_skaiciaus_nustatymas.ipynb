    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "\n",
    "\n",
    "df = pd.read_csv('norm_6_no_outliers.csv')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12fb4fe5",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "4495fe82",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = df.drop(columns=['label']).values"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4a269e79",
   "metadata": {},
   "source": [
    "Empirinis metodas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "026b9432",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Geriausias klasteriu skaicius: 26\n"
     ]
    }
   ],
   "source": [
    "m = X.shape[0]\n",
    "klasteriai = int(np.sqrt(m / 2))\n",
    "print(f\"Geriausias klasteriu skaicius: {klasteriai}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "501a349c",
   "metadata": {},
   "source": [
    "Elbow metodas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "3a5a9def",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 600x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "inercija = []\n",
    "K = range(2, 15)\n",
    "\n",
    "for k in K:\n",
    "    kmeans = KMeans(n_clusters=k, random_state=42)\n",
    "    kmeans.fit(X)\n",
    "    inercija.append(kmeans.inertia_) # metrika, rodanti kaip arti yra taskai prie savo klasterio centro\n",
    "\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.plot(K, inercija, 'bo-')\n",
    "plt.xlabel('Klasteriu skaicius')\n",
    "plt.ylabel('Inercija')\n",
    "plt.title('Elbow metodas')\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
  },
